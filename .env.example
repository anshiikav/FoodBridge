# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/foodbridge
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/foodbridge
MONGODB_URI=mongodb://localhost:27017/foodbridge

# JWT secret key (use a long random string in production)
JWT_SECRET=your-secret-key-change-this

# Server port
PORT=3000

# Node environment
NODE_ENV=development
